# Copy to .env and fill in. Never commit real keys.

# Groq API key (https://console.groq.com/keys). Only needed for `--llm groq`.
GROQ_API_KEY=

# Optional overrides for the LLM adapter.
# CODESHIFT_LLM_MODEL=openai/gpt-oss-120b
# CODESHIFT_LLM_BASE_URL=https://api.groq.com/openai/v1
# Key for provider = "openai-compatible".
# CODESHIFT_LLM_API_KEY=

# Where run history and backups are stored (default: ~/.codeshift).
# CODESHIFT_HOME=

# REST API: repositories must live under this directory (default: working directory).
# CODESHIFT_WORKSPACE_ROOT=
# REST API: require `Authorization: Bearer <token>` when set.
# CODESHIFT_API_TOKEN=
